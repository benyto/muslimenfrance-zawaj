# Server config
PORT=8787
# Origin(s) allowed to call this API — the SPA's dev/prod URL.
CORS_ORIGIN=http://localhost:5173

# Supabase project (same project as apps/web talks to).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Non-secret — same value as apps/web/.env.local's VITE_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=
# Secret/service-role key — bypasses RLS. Never expose this to any client,
# never prefix it VITE_*. Lives only here, on the server.
SUPABASE_SECRET_KEY=

# New, separate UploadThing app (not the monolith's). Single token from the
# UploadThing dashboard (API Keys page) — encodes app id + secret + region.
UPLOADTHING_TOKEN=

# Added when their respective phases land — not needed yet:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
