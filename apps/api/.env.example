# Server config
PORT=8787
# Origin(s) allowed to call this API — the SPA's dev/prod URL.
CORS_ORIGIN=http://localhost:5173
# Trust X-Forwarded-For when deriving request.ip. Leave "false" locally.
# Set to "true" on the VPS, where this runs behind the nginx/Caddy vhost —
# otherwise every request looks like it comes from the proxy, which collapses
# the per-IP rate limit into a single shared bucket and records a useless
# ip_address on every admin_audit_log row. Never set it on an instance that
# is reachable directly, or callers can spoof their own IP.
TRUST_PROXY=false
# The SPA's own URL — used to build Stripe Checkout/Portal return links.
SITE_URL=http://localhost:5173

# Supabase project (same project as apps/web talks to).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Non-secret — same value as apps/web/.env.local's VITE_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=
# Secret/service-role key — bypasses RLS. Never expose this to any client,
# never prefix it VITE_*. Lives only here, on the server.
SUPABASE_SECRET_KEY=

# New, separate UploadThing app (not the monolith's). Single token from the
# UploadThing dashboard (API Keys page) — encodes app id + secret + region.
UPLOADTHING_TOKEN=

# Stripe — same account as the monolith is fine to reuse (see project plan),
# or a fresh one. Webhook secret comes from the endpoint you create in the
# Stripe dashboard pointing at POST {this API's public URL}/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — API key (not the SMTP credentials used for Supabase Auth's magic
# links, a separate thing). "From" must be on a verified Resend domain.
RESEND_API_KEY=
EMAIL_FROM=Rencontre <notifications@login.muslimenfrance.com>
