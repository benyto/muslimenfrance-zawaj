# New, separate Supabase project (not the muslimenfrance monolith's).
# These two are safe to ship in the client bundle — the publishable key is
# gated entirely by RLS. Never put the secret key in a VITE_* variable;
# that lives only in apps/api's server-side environment.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Our own backend (apps/api) — see apps/api/.env.example.
VITE_API_URL=http://localhost:8787

# Stripe publishable key (client-safe). Secret key + webhook secret are
# apps/api server-side env vars only.
VITE_STRIPE_PUBLISHABLE_KEY=

# New, separate UploadThing app (not the monolith's).
VITE_UPLOADTHING_APP_ID=

VITE_SITE_URL=http://localhost:5173
