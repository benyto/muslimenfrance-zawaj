# Copy to .env.local (gitignored) and fill in real values before running
# any script in this directory.

# The old muslimenfrance monolith's Supabase project (source).
MONOLITH_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
MONOLITH_SUPABASE_SECRET_KEY=

# This project's Supabase project (destination). Same values as apps/api/.env.
RENCONTRE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
RENCONTRE_SUPABASE_SECRET_KEY=

# UploadThing token for the destination app — photos are downloaded from the
# monolith's UploadThing app and re-uploaded here (different app/domain,
# same as apps/api/.env's UPLOADTHING_TOKEN).
RENCONTRE_UPLOADTHING_TOKEN=
